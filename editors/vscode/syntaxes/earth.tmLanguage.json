{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Earth",
  "scopeName": "source.earth",
  "patterns": [
    {
      "name": "comment.line.number-sign.earth",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.earth",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.earth",
          "match": "\\\\[\"\\\\nrt]"
        }
      ]
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(?:fonksiyon|function|fn)(?![\\p{L}\\p{N}_])\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "0": {
          "name": "storage.type.function.earth"
        },
        "1": {
          "name": "entity.name.function.earth"
        }
      }
    },
    {
      "name": "keyword.control.earth",
      "match": "(?<![\\p{L}\\p{N}_])(?:içe_aktar|ice_aktar|değişken|degisken|continue|değilse|degilse|içinde|icinde|döndür|dondur|return|yakala|fırlat|firlat|import|while|break|devam|catch|throw|eğer|eger|else|iken|dene|let|her|for|kır|kir|try|if|in)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.language.earth",
      "match": "(?<![\\p{L}\\p{N}_])(?:yanlış|yanlis|doğru|dogru|false|true|boş|bos|nil)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.operator.word.earth",
      "match": "(?<![\\p{L}\\p{N}_])(?:değil|degil|veya|and|not|ve|or)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "support.function.builtin.earth",
      "match": "(?<![\\p{L}\\p{N}_])(?:anahtarlar|büyük_harf|buyuk_harf|küçük_harf|kucuk_harf|birleştir|birlestir|değerler|degerler|contains|değiştir|degistir|rastgele|en_küçük|en_kucuk|en_büyük|en_buyuk|uzunluk|replace|karekök|karekok|yuvarla|reverse|aralık|aralik|number|values|içerir|icerir|remove|mutlak|random|sırala|sirala|print|girdi|input|range|metin|upper|lower|split|round|taban|floor|tavan|topla|dilim|slice|sayı|sayi|ekle|push|type|keys|kırp|kirp|trim|join|sqrt|ceil|sort|ters|yaz|len|str|tür|tur|sil|böl|bol|abs|pow|min|max|sum|üs|us)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.numeric.earth",
      "match": "(?<![\\p{L}\\p{N}_])\\d+(?:\\.\\d+)?"
    },
    {
      "name": "keyword.operator.earth",
      "match": "==|!=|<=|>=|[-+*/%<>=]"
    },
    {
      "match": "([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.earth"
        }
      }
    }
  ]
}